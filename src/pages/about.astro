---
import Layout from '../layouts/Layout.astro';
import SkillBadge from '../components/SkillBadge.astro';
---

<Layout title="About Me | O'Damilare Jegede" description="Learn about my background, expertise, and passion for digital learning and instructional design.">
  <section class="about-hero">
    <div class="container">
      <div class="about-content">
        <div class="about-image">
          <img src="/images/profile-photo.jpg" alt="O'Damilare Jegede" />
        </div>
        <div class="about-text">
          <h1>About Me</h1>
          <p class="lead">With expertise in instructional design, e-learning development, and LMS administration, I create engaging, results-driven digital learning solutions that enhance organizational training and educational outcomes.</p>
          <p>I specialize in developing interactive eLearning modules, managing learning management systems, and designing curriculum that bridges the gap between pedagogy and technology. My approach combines solid instructional design principles with creative solutions to make learning accessible, engaging, and effective.</p>
          <p>Currently based in Kampala, Uganda, I bring both academic knowledge and practical expertise to every project, with experience working across educational institutions and corporate environments.</p>
          <div class="about-cta">
            <a href="/contact" class="btn btn-primary">Let's Work Together</a>
            <a href="/files/cv.pdf" class="btn btn-outline" download>Download CV</a>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <section class="section education-section">
    <div class="container">
      <div class="section-title">
        <h2>Education & Certifications</h2>
      </div>
      
      <div class="timeline">
        <div class="timeline-item">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <h3>Master of Education (M.Ed.) – Educational Technology</h3>
            <p class="timeline-date">2020</p>
            <p>University of Ibadan, Nigeria</p>
            <p>Focused on digital learning strategies, instructional design models, and educational technology integration.</p>
          </div>
        </div>
        
        <div class="timeline-item">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <h3>Bachelor of Education (B.Ed.) – Special Needs Education</h3>
            <p class="timeline-date">2015</p>
            <p>University of Ibadan, Nigeria</p>
            <p>Specialized in Learning Disabilities with a focus on educational interventions and support strategies.</p>
          </div>
        </div>
        
        <div class="timeline-item">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <h3>National Youth Service Corps (NYSC)</h3>
            <p class="timeline-date">2017</p>
            <p>Completed mandatory national service with additional SAED certification.</p>
          </div>
        </div>
        
        <div class="timeline-item">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <h3>WOFBI Leadership Certificate Course (LCC)</h3>
            <p class="timeline-date">2016</p>
            <p>Advanced leadership training focused on organizational management and team development.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <section class="section skills-section">
    <div class="container">
      <div class="section-title">
        <h2>Skills & Expertise</h2>
      </div>
      
      <div class="skills-categories">
        <div class="skills-category">
          <h3>eLearning Development</h3>
          <div class="skills-grid">
            <SkillBadge name="Articulate Storyline" icon="fab fa-artstation" level={5} />
            <SkillBadge name="Camtasia" icon="fas fa-video" level={5} />
            <SkillBadge name="iSpring Suite" icon="fas fa-file-powerpoint" level={4} />
            <SkillBadge name="Wondershare Filmora" icon="fas fa-film" level={4} />
            <SkillBadge name="VideoScribe" icon="fas fa-pencil-alt" level={4} />
            <SkillBadge name="Media Development" icon="fas fa-desktop" level={5} />
          </div>
        </div>
        
        <div class="skills-category">
          <h3>Instructional Design</h3>
          <div class="skills-grid">
            <SkillBadge name="Instructional Design Systems" icon="fas fa-sitemap" level={5} />
            <SkillBadge name="Curriculum Development" icon="fas fa-book" level={5} />
            <SkillBadge name="Training Facilitation" icon="fas fa-users" level={5} />
            <SkillBadge name="Interactive Simulations" icon="fas fa-vr-cardboard" level={4} />
            <SkillBadge name="E-Learning Content Evaluation" icon="fas fa-chart-line" level={5} />
            <SkillBadge name="Project Management" icon="fas fa-tasks" level={4} />
          </div>
        </div>
        
        <div class="skills-category">
          <h3>Tools & Platforms</h3>
          <div class="skills-grid">
            <SkillBadge name="Moodle" icon="fas fa-server" level={5} />
            <SkillBadge name="TalentLMS" icon="fas fa-graduation-cap" level={5} />
            <SkillBadge name="Microsoft Power BI" icon="fab fa-microsoft" level={4} />
            <SkillBadge name="Tableau" icon="fas fa-chart-bar" level={4} />
            <SkillBadge name="Microsoft Office Suite" icon="fas fa-file-word" level={5} />
            <SkillBadge name="LMS Administration" icon="fas fa-cogs" level={5} />
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <section class="section experience-section">
    <div class="container">
      <div class="section-title">
        <h2>Professional Experience</h2>
      </div>
      
      <div class="timeline">
        <div class="timeline-item">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <h3>Digital Learning Specialist</h3>
            <p class="timeline-date">March 2024 – Present</p>
            <p class="timeline-company">Kampala International University, Kampala, Uganda</p>
            <ul>
              <li>Design and develop engaging online courses aligned with educational objectives</li>
              <li>Manage the university's Learning Management System (LMS), ensuring seamless delivery of digital learning</li>
              <li>Provide training and support to faculty and staff on digital tools for effective online teaching</li>
            </ul>
          </div>
        </div>
        
        <div class="timeline-item">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <h3>Business Relations Manager</h3>
            <p class="timeline-date">August 2022 – February 2024</p>
            <p class="timeline-company">MoniePoint Inc., Lagos, Nigeria</p>
            <ul>
              <li>Created and managed product distribution supply chains across 7 states</li>
              <li>Partnered with state trainers to design hybrid (physical and digital) training programs for new managers</li>
              <li>Evaluated organizational needs and developed retraining programs for business teams</li>
            </ul>
          </div>
        </div>
        
        <div class="timeline-item">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <h3>E-Learning Developer (Freelancer)</h3>
            <p class="timeline-date">September 2019 – August 2022</p>
            <p class="timeline-company">GTFIELDS, Ibadan, Nigeria</p>
            <ul>
              <li>Developed curricula, e-learning formats, and lesson presentations for diverse topics</li>
              <li>Designed LMS systems for private schools and trained staff on content development</li>
              <li>Evaluated course performance and implemented improvements for better engagement</li>
            </ul>
          </div>
        </div>
        
        <div class="timeline-item">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <h3>Instructional Designer (Contract)</h3>
            <p class="timeline-date">August 2020 – September 2020</p>
            <p class="timeline-company">H. Pierson Associates Limited, Lagos, Nigeria</p>
            <ul>
              <li>Developed instructional design scripts and slide templates aligned with company goals</li>
              <li>Collaborated with eLearning developers to implement strategic learning solutions</li>
              <li>Peer-reviewed audio narration scripts for quality assurance</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <section class="section personal-section">
    <div class="container">
      <div class="personal-content">
        <div class="personal-text">
          <h2>Academic Contributions</h2>
          <p>I'm passionate about contributing to the field of educational technology through research and presentations. Recently, I presented on "Awareness, Availability, and Utilization of Computer-Based Instructional Software Among Undergraduates in Nigeria" at the Fully Online Distance Education Symposium, University of Pretoria, South Africa (2024).</p>
          <p>My approach to both work and life is guided by continuous learning and improvement. I believe that the best learning experiences come from understanding the unique needs of each learner and creating solutions that meet them where they are.</p>
        </div>
        <div class="personal-image">
          <img src="/images/personal-photo.jpg" alt="Academic presentation" />
        </div>
      </div>
    </div>
  </section>
  
  <section class="section cta-section">
    <div class="container">
      <div class="cta-content">
        <h2>Let's create impactful learning experiences together</h2>
        <p>Whether you need custom eLearning development, LMS implementation, or instructional design consultation, I'm here to help.</p>
        <a href="/contact" class="btn btn-primary">Get in Touch</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* About Hero Section */
  .about-hero {
    padding: var(--spacing-xl) 0;
  }
  
  .about-content {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--spacing-xl);
    align-items: center;
  }
  
  .about-image {
    position: relative;
  }
  
  .about-image img {
    width: 100%;
    border-radius: var(--border-radius-md);
    box-shadow: var(--shadow-md);
  }
  
  .about-image::after {
    content: '';
    position: absolute;
    top: 20px;
    left: 20px;
    width: 100%;
    height: 100%;
    border: 3px solid var(--accent);
    border-radius: var(--border-radius-md);
    z-index: -1;
  }
  
  .about-text h1 {
    margin-bottom: var(--spacing-md);
    position: relative;
    display: inline-block;
    padding-bottom: var(--spacing-sm);
  }
  
  .about-text h1::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 80px;
    height: 3px;
    background-color: var(--accent);
  }
  
  .lead {
    font-size: 1.25rem;
    font-weight: 500;
    margin-bottom: var(--spacing-md);
  }
  
  .about-cta {
    display: flex;
    gap: var(--spacing-md);
    margin-top: var(--spacing-lg);
  }
  
  /* Timeline */
  .timeline {
    position: relative;
    max-width: 800px;
    margin: 0 auto;
    padding: var(--spacing-md) 0;
  }
  
  .timeline::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 20px;
    width: 2px;
    background-color: var(--primary);
  }
  
  .timeline-item {
    position: relative;
    padding-left: 60px;
    margin-bottom: var(--spacing-lg);
  }
  
  .timeline-marker {
    position: absolute;
    top: 5px;
    left: 11px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background-color: var(--primary);
    border: 4px solid var(--background);
    z-index: 1;
  }
  
  .timeline-content {
    background-color: var(--background);
    padding: var(--spacing-md);
    border-radius: var(--border-radius-md);
    box-shadow: var(--shadow-sm);
  }
  
  .timeline-content h3 {
    margin-bottom: var(--spacing-xs);
    color: var(--primary);
  }
  
  .timeline-date {
    font-weight: 600;
    color: var(--accent-dark);
    margin-bottom: var(--spacing-sm);
  }
  
  .timeline-company {
    font-weight: 600;
    margin-bottom: var(--spacing-sm);
  }
  
  .timeline-content ul {
    list-style-type: disc;
    padding-left: var(--spacing-lg);
    margin-top: var(--spacing-sm);
  }
  
  .timeline-content li {
    margin-bottom: var(--spacing-xs);
  }
  
  /* Skills Section */
  .skills-section {
    background-color: var(--background-alt);
  }
  
  .skills-categories {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xl);
  }
  
  .skills-category h3 {
    margin-bottom: var(--spacing-md);
    color: var(--primary);
    position: relative;
    display: inline-block;
    padding-bottom: var(--spacing-xs);
  }
  
  .skills-category h3::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 40px;
    height: 2px;
    background-color: var(--accent);
  }
  
  .skills-grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-md);
  }
  
  /* Personal Section */
  .personal-content {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: var(--spacing-xl);
    align-items: center;
  }
  
  .personal-image img {
    width: 100%;
    border-radius: var(--border-radius-md);
    box-shadow: var(--shadow-md);
  }
  
  /* Responsive Adjustments */
  @media (max-width: 768px) {
    .about-content, .personal-content {
      grid-template-columns: 1fr;
    }
    
    .about-image {
      margin-bottom: var(--spacing-lg);
    }
    
    .about-cta {
      flex-direction: column;
    }
    
    .timeline::before {
      left: 15px;
    }
    
    .timeline-item {
      padding-left: 50px;
    }
    
    .timeline-marker {
      left: 6px;
    }
  }
</style>
